---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Card from '../components/card/Card.astro';
import Button from '../components/button/Button.astro';

const INITIAL_COUNT = 6;

const projects = await getCollection('projects');
const order = [
   'matjo-rebranding',
   'recipe-book',
   'caro-unternehmensberatung',
   'restaurant-ordering',
   'loem',
   'gusstudio',
   'matjo',
   'ramen1974',
   'anamit',
   'aroi',
   'communardo',
   'lidl-gesagt-getan',
   'ready-for-green',
];

const orderedProjects = order
   .map((slug) => projects.find((project) => project.id === slug))
   .filter(Boolean);
const initialProjects = orderedProjects.slice(0, INITIAL_COUNT);
const remainingProjects = orderedProjects.slice(INITIAL_COUNT);
const hasMoreProjects = remainingProjects.length > 0;
---

<script>
    const LOAD_MORE_SIZE = 3;
    const thresholds = [0.1, 0.3, 0.5, 0.7, 0.9];
    const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: thresholds,
    };

    function setupProjectsPage() {
        const cardList = document.querySelector('.teaser-card-list');
        const moreTemplate = document.querySelector('#projects-more');
        const loadMoreContainer = document.querySelector('.js-load-more');
        const loadMoreButton = loadMoreContainer?.querySelector('button');

        if (!cardList) return;

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add('visible');
                    }, index * 250);
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        function getListedCards() {
            return Array.from(cardList.querySelectorAll('.teaser-card'));
        }

        function observeCards(cards) {
            cards.forEach((item, index) => {
                item.classList.remove('visible');
                setTimeout(() => {
                observer.observe(item);
                }, index * 100);
            });
        }

        observeCards(getListedCards());

        function revealNextBatch() {
            if (!moreTemplate) return;

            const remainingCards = Array.from(
                moreTemplate.content.querySelectorAll('.teaser-card')
            );
            const nextBatch = remainingCards.slice(0, LOAD_MORE_SIZE);

            nextBatch.forEach((card) => {
                cardList.appendChild(card);
            });

            observeCards(nextBatch);

            if (
                moreTemplate.content.querySelectorAll('.teaser-card').length === 0 &&
                loadMoreContainer
            ) {
                loadMoreContainer.remove();
            }
        }

        function onLoadMoreClick(event) {
            event.preventDefault();
            revealNextBatch();
        }

        loadMoreButton?.addEventListener('click', onLoadMoreClick);

        return () => {
            getListedCards().forEach((item) => {
                observer.unobserve(item);
            });
            loadMoreButton?.removeEventListener('click', onLoadMoreClick);
        };
    }

    let cleanup;

    document.addEventListener('astro:page-load', () => {
        cleanup?.();
        cleanup = setupProjectsPage();
    });

    document.addEventListener('astro:before-preparation', () => {
        cleanup?.();
        cleanup = undefined;
    });
</script>

<Layout
    title="Portfolio | Projects | Duc Anh Dennis Nguyen | DepTrai"
    metaDescription="This is my portfolio page and here is a sample of projects I have worked on."
>
    <div class="inner">
        <div class="content-area">
            <div id="projects" class="section-header">
                <h1 class="sr-only">
                    This page contains an overview of my projects
                </h1>
                <h2>Projects</h2>
            </div>
            <p>Here is a small sample of projects I have worked on.</p>
            <p>
                Many of these projects were written with Vue.js, but I am also
                proficient with Web Components/Vanilla JavaScript and I'm also
                familiar with React and AngularJS.
            </p>
            <p>
                I am already looking forward to grow the list significantly in the
                near future!
            </p>
        </div>
        <ul role="list" class="teaser-card-list">
            {
                initialProjects.map((project) => (
                    <Card
                        href={project.data.href}
                        title={project.data.title}
                        body={project.data.description}
                        image={project.data.image}
                        stack={project.data.stack}
                    />
                ))
            }
        </ul>
        {
            hasMoreProjects && (
                <>
                    <template id="projects-more">
                        {
                            remainingProjects.map((project) => (
                                <Card
                                href={project.data.href}
                                title={project.data.title}
                                body={project.data.description}
                                image={project.data.image}
                                stack={project.data.stack}
                                />
                            ))
                        }
                    </template>
                    <div class="js-load-more load-more">
                        <Button type="button" variant="ghost">Load more</Button>
                    </div>
                </>
            )
        }
    </div>
</Layout>

<style lang="scss">
   .teaser-card-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
      gap: 2rem;
      padding: 0;
   }

   .load-more {
      display: flex;
      justify-content: center;
      margin-block-start: 2.5rem;
   }
</style>
